	quest.7A72646BB6006369.title: "Emerald"
	quest.7A9161236A9F1808.quest_desc: ["Nature and Dirt."]
	quest.7A9161236A9F1808.title: "Wood"
	quest.7A9FF28B5EF2A95C.quest_desc: ["Empty crop sticks gather weeds, and they choke the plant next to them. The rake clears them."]
	quest.7A9FF28B5EF2A95C.title: "Hand rake"
	quest.7B5E11535C33FBE5.quest_desc: ["Variations of wool, carpets and fabrics."]
	quest.7B5E11535C33FBE5.title: "Loom table"
	quest.7BDEC9D4D4D2ECAF.quest_desc: ["Variations of lanterns, chains and metal pieces."]
	quest.7BDEC9D4D4D2ECAF.title: "Tinkering table"
