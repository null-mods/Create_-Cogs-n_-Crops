	quest.7C48C9B4C4B3732B.title: "Coral"
	quest.7CABFED6BE13A7BD.quest_desc: ["Water and Zombie."]
	quest.7CABFED6BE13A7BD.title: "Slime"
	quest.7D66BDA53E96EA73.quest_desc: ["Two Inferium plants side by side and a double crop stick in the middle. Patience."]
	quest.7D66BDA53E96EA73.title: "First mutation: coal"
	quest.7DC6BE5BAC31F370.quest_desc: ["Create's Factory Gauge watches how much of an item you have and orders more through the package network when the stock runs low."]
	quest.7DC6BE5BAC31F370.title: "Factory Gauge"
	quest.7E0F19CD38235CF7.quest_desc: ["Keep tools and items in a box on the ground and pull them into your hotbar from a distance. Dye it to have several."]
	quest.7E0F19CD38235CF7.title: "Toolbox"
	quest.7EE851A15D6643AD.quest_desc: ["Zinc and gold. The foundry metal."]
	quest.7EE851A15D6643AD.title: "Tungsten"
	quest.7F30C6F07CBB31B0.quest_desc: ["Nature and dandelion."]
	quest.7F30C6F07CBB31B0.title: "Dye"
	quest.7F7CFEED35E8D48D.quest_desc: [
		"Horses become long-term companions: bond with yours, pick among fifteen breeds, use proper tack and carts."
		"Call your horse with the whistle key."
	]
	quest.7F7CFEED35E8D48D.title: "Icy's Better Horses"
	quest.7FE36B0D93709094.quest_desc: ["Gold and lapis lazuli. The rest of the tree is in the agricultural journal."]
	quest.7FE36B0D93709094.title: "Diamond"
